---
import RibbonStreetBackground from '../components/RibbonStreetBackground.astro'
import Navigation from '../components/Navigation.astro'
import Socials from '../components/Socials.astro'

const Title = (await Astro.glob('../content/landing/title.md'))[0]
---

<section class="landing">
    <RibbonStreetBackground />
    <Title.Content />
    <Navigation />
    <Socials />
</section>

<style>
    .landing {
        position: relative;
        background-color: hsla(255, 21%, 11%, 0.75);
        min-height: 100vh;
        overflow: hidden;
    }
</style>
