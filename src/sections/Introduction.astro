---
const Text = (await Astro.glob('../content/introduction/text.md'))[0]
---

<section id="introduction">
    <Text.Content />
</section>

<style>
    section {
        max-width: var(--container-width);
        margin: auto;
        text-align: center;
        padding: 4em 0.75em;
        font-size: 1.25em;
    }

    section :global(h2) {
        margin-bottom: 1em;
    }

    section :global(p) {
        font-weight: var(--font-wt-light);
    }
</style>