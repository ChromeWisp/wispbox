---
import { socials } from '../content/socials'
---

<ul class="socials">
    {socials.map(social => (
        <li><a class="social-link" href={social.link} title={social.name} target="_blank">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox={social.viewBox}>
                <title>{social.name}</title>
                <path d={social.iconPath} />
            </svg>
        </a></li>
    ))}
</ul>

<style>
    .socials {
        list-style: none;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .social-link {
        color: var(--c-text);
        display: block;
        margin: 0 0.5em;
    }

    .social-link:hover {
        color: var(--c-primary);
    }
</style>