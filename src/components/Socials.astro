---
import Twitter from './icons/Twitter.astro'
import LinkedIn from './icons/LinkedIn.astro'
---

<ul class="socials">
    <li><a class="social-link" href="https://twitter.com/ChromeWisp" title="Twitter" target="_blank"><Twitter /></a></li>
    <li><a class="social-link" href="https://www.linkedin.com/in/phillipsbrendan/" title="LinkedIn" target="_blank"><LinkedIn /></a></li>
</ul>

<style>
    .socials {
        list-style: none;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .social-link {
        color: var(--c-text);
        display: block;
        margin: 0 0.5em;
    }

    .social-link:hover {
        color: var(--c-primary);
    }
</style>